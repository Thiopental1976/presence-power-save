# Copie para ~/.config/cedro-presence/env (chmod 600) e preencha com os
# valores reais do SEU dispositivo. Esse arquivo real NUNCA deve ir pro git
# (está no .gitignore) — é dado pessoal, não faz sentido publicado.

# MAC Bluetooth do celular, já pareado (bluetoothctl devices Paired).
PRESENCE_BT_MAC=AA:BB:CC:DD:EE:FF

# idVendor USB (4 hex) do celular. Descubra com o celular plugado:
#   lsusb | grep -i <marca do seu celular>
# Confira que nenhum outro periférico seu usa o mesmo vendor ID antes de
# confiar só nele (cat /sys/bus/usb/devices/*/idVendor).
PRESENCE_USB_VENDOR=0000

# Opcional. Janela de carência (segundos) do lado do celular só — ver README.
# Default 600 (10min) se omitido. Encurte pra testar em modo observador sem
# esperar 10min por ciclo; NÃO encurte em produção sem entender o trade-off
# (janela curta = mais chance de cair pra ECO num soluço momentâneo de rádio).
#PRESENCE_ABSENCE_WINDOW_S=600

# Opcional. Intervalo (segundos) entre tentativas proativas de reconectar o
# celular via Bluetooth enquanto desconectado — ver README. Default 30s.
#PRESENCE_BT_RECONNECT_INTERVAL_S=30
